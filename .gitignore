node_modules/
dist/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# Source video for the in-tile frame sequences. Frames are extracted locally
# and committed as WebP; the MP4s never are — they are large, they are not what
# the page serves, and CLAUDE.md rules out <video> for scroll-driven sequences.
*.mp4
*.mov
*.webm
